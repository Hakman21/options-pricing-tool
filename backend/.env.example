# Copy to .env for local overrides. Every value here is a default, so the app runs
# with none of them set.

# Live market data. Turn off to run entirely on manual input — useful for a demo
# where you would rather not depend on an upstream you do not control.
OPT_MARKET_DATA_ENABLED=true
OPT_MARKET_DATA_TIMEOUT_S=3.0
OPT_MARKET_CACHE_TTL_S=900

# Only needed if the frontend calls the API cross-origin. In the intended
# deployment a Vercel rewrite puts both on the same origin and this stays empty.
# OPT_CORS_ORIGINS=["https://hakimahmed.com"]

# Guard rails on the expensive endpoints.
OPT_MAX_BINOMIAL_STEPS=5000
OPT_MAX_MONTE_CARLO_PATHS=2000000
OPT_MAX_CONVERGENCE_STEPS=400
OPT_MAX_CONVERGENCE_PATHS=200000

# Set by the Docker build; leave alone locally.
# OPT_GIT_SHA=
# OPT_BUILD_TIME=
